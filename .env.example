# NaviGlass Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required for AI narration)
GEMINI_API_KEY=your_gemini_api_key_here

# Bluetooth Audio Device MAC Address (optional)
# Leave empty to scan and connect manually
# Format: XX:XX:XX:XX:XX:XX
BLUETOOTH_DEVICE_MAC=

# TTS Settings (optional)
TTS_RATE=150
TTS_VOLUME=1.0

# Face Recognition Settings (optional)
FACE_RECOGNITION_TOLERANCE=0.6
FACE_RECOGNITION_INTERVAL=5
